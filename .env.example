# Baked in at BUILD time. When the site is served over HTTPS these must be
# https:// and wss:// — a browser refuses a ws:// socket from an HTTPS page.
# To override an already-built image at runtime, use Nuxt's runtime-config env
# names instead: NUXT_PUBLIC_API_URL and NUXT_PUBLIC_WS_URL.
API_BASE_URL=http://localhost:4100/api
WS_BASE_URL=ws://localhost:4100/ws
GOOGLE_CLIENT_ID=683069118324-3k7pnntof5qpofvr8284ff3j8e6tn07b.apps.googleusercontent.com
